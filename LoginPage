<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartGrade - Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background-color: #fcfcfd;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .btn-gradient {
            background: linear-gradient(90deg, #3b42d4 0%, #d414cc 100%);
        }
        .social-btn {
            border: 1px solid #e5e7eb;
            transition: background 0.2s;
        }
        .social-btn:hover {
            background-color: #f9fafb;
        }
    </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen p-6">
    <div class="text-center mb-10">
        <div class="flex justify-center mb-4">
            <svg width="80" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3L1 9L12 15L21 10.09V17H23V9L12 3Z" fill="#3b42d4"/>
                <path d="M5 13.18V17.18L12 21L19 17.18V13.18L12 17L5 13.18Z" fill="#d414cc"/>
            </svg>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-gray-800">
            SMART<span class="text-gray-500 font-light">GRADE</span>
        </h1>
        <h2 class="text-2xl font-bold mt-8 text-gray-800">Bem-vindo</h2>
        <p class="text-gray-500 mt-2">Acesse sua conta de professor.</p>
    </div>
    <form class="w-full max-w-sm">
        <div class="mb-5">
            <label class="block text-gray-700 font-semibold mb-2">E-mail</label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                    <i class="fa-regular fa-envelope"></i>
                </span>
                <input type="email" placeholder="nome@instituicao.edu" 
                    class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition">
            </div>
        </div>
        <div class="mb-4">
            <div class="flex justify-between mb-2">
                <label class="text-gray-700 font-semibold">Senha</label>
                <a href="#" class="text-sm font-bold text-indigo-600">Esqueceu a senha?</a>
            </div>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                    <i class="fa-solid fa-lock"></i>
                </span>
                <input type="password" placeholder="••••••••" 
                    class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition">
            </div>
        </div>
        <div class="flex items-center mb-6">
            <input type="checkbox" id="remember" class="w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
            <label for="remember" class="ml-2 text-gray-600 font-medium">Lembrar-me</label>
        </div>
        <button type="submit" class="w-full btn-gradient text-white font-bold py-4 rounded-2xl shadow-lg hover:opacity-90 transition transform active:scale-95">
            Entrar
        </button>
    </form>
    <div class="w-full max-w-sm flex items-center my-8">
        <div class="flex-grow border-t border-gray-200"></div>
        <span class="mx-4 text-gray-400 text-sm">ou continue com</span>
        <div class="flex-grow border-t border-gray-200"></div>
    </div>
    <div class="w-full max-w-sm flex gap-4 mb-10">
        <button class="flex-1 social-btn flex items-center justify-center py-3 rounded-xl gap-2 font-semibold text-gray-700">
            <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" class="w-5 h-5" alt="Google">
            Google
        </button>
        <button class="flex-1 social-btn flex items-center justify-center py-3 rounded-xl gap-2 font-semibold text-gray-700">
            <i class="fa-brands fa-apple text-xl"></i>
            Apple
        </button>
    </div>
    <div class="text-center">
        <p class="text-gray-600 mb-8">Não tem uma conta? <a href="#" class="text-indigo-600 font-bold">Criar conta</a></p>
        <div class="flex gap-6 text-gray-400 text-sm font-medium">
            <a href="#">Ajuda</a>
            <a href="#">Privacidade</a>
            <a href="#">Termos</a>
        </div>
    </div>
</body>
</html>
